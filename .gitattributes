# Windows batch launchers must check out with CRLF on every machine,
# regardless of the cloning VM's core.autocrlf setting. cmd.exe is most
# reliable with CRLF; this removes any line-ending ambiguity.
*.cmd text eol=crlf
*.bat text eol=crlf

# Model checksum covers exact bytes, including newlines.
crates/mixed-input/data/model.txt text eol=lf
crates/mixed-input/data/dictionary/*.txt text eol=lf
crates/mixed-input/data/manifest.toml text eol=lf
